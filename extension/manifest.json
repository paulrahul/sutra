{
  "manifest_version": 3,
  "name": "Sutra",
  "version": "0.1.0",
  "description": "Insights from your browsing patterns",
  "permissions": ["history", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "img/sutra_icon_16.png",
    "32": "img/sutra_icon_32.png",
    "48": "img/sutra_icon_48.png",
    "128": "img/sutra_icon_128.png"
  }
}
